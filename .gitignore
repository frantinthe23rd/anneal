# Secrets
env.local.sh

# The installation root chosen by setup.sh — per machine, never shared.
.anneal-root

# Runtime state (lives on the SSD, but keep these out if ever produced here)
*.log
*.pid
outputs/
__pycache__/
*.pyc
.DS_Store

# Agent worktrees — checkouts of this same repo, never part of it.
.claude/worktrees/
